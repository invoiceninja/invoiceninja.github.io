{"title":"Body","body":{"description":"Tag object that needs to be added to the company catalog","required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"entity_type":{"description":"Required on create. Immutable after creation.","type":"string","enum":["App\\Models\\Company","App\\Models\\BankTransaction","App\\Models\\Client","App\\Models\\Credit","App\\Models\\Expense","App\\Models\\Invoice","App\\Models\\Payment","App\\Models\\Product","App\\Models\\Project","App\\Models\\PurchaseOrder","App\\Models\\Quote","App\\Models\\RecurringExpense","App\\Models\\RecurringInvoice","App\\Models\\Task","App\\Models\\Vendor"],"example":"App\\Models\\Task"},"name":{"description":"The tag name. Commas are not allowed. Unique per company and entity type, including archived tags.","type":"string","maxLength":191,"pattern":"^[^,]+$","example":"Urgent"},"color":{"description":"The tag color as a 3 or 6 digit hex value, or null to clear it.","type":"string","nullable":true,"pattern":"^#(?:[0-9a-fA-F]{3}){1,2}$","example":"#FF0000"}},"required":["entity_type","name"],"title":"TagRequest"},"example":{"entity_type":"task","name":"Urgent","color":"#FF0000"}}}}}