{
  "name": "invoiceninja-docs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start --port 3010 --host 0.0.0.0",
    "build": "docusaurus build && node scripts/search-context.cjs",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "gen-api-docs": "docusaurus gen-api-docs invoiceninja",
    "clean-api-docs": "docusaurus clean-api-docs invoiceninja",
    "icons:sync": "node scripts/extract-icons.js",
    "icons:check": "node scripts/extract-icons.js && git diff --exit-code static/assets/images/icons",
    "search:check": "node scripts/check-search.cjs && node scripts/check-search-relevance.cjs",
    "search:benchmark": "node scripts/benchmark-search.cjs",
    "search:report": "node scripts/report-search.cjs",
    "search:measure": "node scripts/measure-search-browser.cjs",
    "search:test": "node --test tests/search-context.test.cjs",
    "search:smoke": "playwright test"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.0",
    "@docusaurus/plugin-client-redirects": "^3.10.0",
    "@docusaurus/preset-classic": "^3.10.0",
    "@easyops-cn/docusaurus-search-local": "^0.55.0",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "docusaurus-plugin-openapi-docs": "^5.0.0",
    "docusaurus-plugin-sass": "^0.2.6",
    "docusaurus-theme-openapi-docs": "^5.0.0",
    "lunr": "2.3.9",
    "prism-react-renderer": "^2.3.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "video.js": "^8.0.4",
    "videojs-contrib-dash": "^5.1.1",
    "videojs-contrib-quality-levels": "^4.1.0",
    "videojs-hls-quality-selector": "^2.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.0",
    "@docusaurus/tsconfig": "^3.10.0",
    "@docusaurus/types": "^3.10.0",
    "@playwright/test": "1.65.1",
    "cheerio": "1.0.0-rc.12",
    "typescript": "~5.6.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  }
}
